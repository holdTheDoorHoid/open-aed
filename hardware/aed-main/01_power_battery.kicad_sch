		(uuid "1c5b9a87-8f3b-5fde-be1c-90b85547a5ac")
	)
	(text_box "F101 main fuse 25 A (Littelfuse 456 NANO2) VBAT_PACK -> VBAT_SYS"
		(exclude_from_sim no)
		(at 25.4 87.344 0)
		(size 140 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
