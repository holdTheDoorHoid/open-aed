	(text_box "SEQ_ACT_S_N, SEQ_DONE_S_N (open-drain from 12): 100 kOhm to 3V3_SUP, open or unpowered reads \"not active / not done\" (R11). SBZ_INT_N\n(open drain from 16): 100 kOhm. CANCEL_S_N (contact to GND on 06): 10 kOhm."
		(exclude_from_sim no)
		(at 450.945 96.107 0)
