			)
			(justify left top)
		)
		(uuid "f7d01bec-8920-5ee2-b3ad-b871808ec3ab")
	)
	(text_box "Ioff receivers on 3V3_SUP (rule R7)"
		(exclude_from_sim no)
		(at 185.72 77.087 0)
		(size 244.905 5.35)
