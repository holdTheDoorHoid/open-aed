	)
	(text_box "NTC_CAP_S (10 kOhm NTC on J1102, sheet 11, to GND): 10.0 kOhm 0.1 % bias to VDDA_S (= the ADC reference), then 1 kOhm + 100\nnF at the ADC pin (P1_10, ADC0_A8). Half-scale at 25 C."
		(exclude_from_sim no)
		(at 624.265 117.697 0)
		(size 140 6.318)
		(margins 0.9525 0.9525 0.9525 0.9525)
