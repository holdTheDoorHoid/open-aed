	(text_box "Over-voltage force (R-10): OVP_TRIP -> Q1111 -> one TLP187 LED per stack; transistors short each bottom gate to HV_RTN"
		(exclude_from_sim no)
		(at 25.4 242.551 0)
		(size 203.24 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
