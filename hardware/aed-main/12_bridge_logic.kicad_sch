		)
		(uuid "91777ee4-7760-5e7d-9180-b686f65a73e2")
	)
	(text_box "One SN74LVC2G07 per controller, so each controller's view has its own part. SEQ_ACT = ACT, SEQ_DONE = NOT RUN_L (planned end or fault), BR_FAULT = FLT. Pull-ups on 04 (3V3_MAIN) and 05 (3V3_SUP); with\nBRIDGE_3V3 off the outputs are released (Ioff) = 'not active / not done / no fault' (contract §5.7)."
		(exclude_from_sim no)
		(at 25.4 685.672 0)
		(size 227.875 6.318)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
