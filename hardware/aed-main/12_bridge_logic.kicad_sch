	)
	(text_box "Fault latch FLT and the latched 25 ms cap (§B13.3 rules 4 and 6, R-4)"
		(exclude_from_sim no)
		(at 876.385 395.19 0)
		(size 255.62 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
