	(text_box "Open-drain status to both controllers (§B13.7): SEQ_ACT_*_N, SEQ_DONE_*_N, BR_FAULT_N"
		(exclude_from_sim no)
		(at 25.4 679.322 0)
		(size 227.875 5.35)
