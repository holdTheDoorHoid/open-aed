	)
	(text_box "High-side kill latch (rev 0.3 D-7, I-8): an over-current or idle-current fault removes G_HA and G_HB at once"
		(exclude_from_sim no)
		(at 840.61 809.813 0)
		(size 267.185 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
