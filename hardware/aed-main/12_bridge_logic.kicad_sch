	)
	(text_box "Low-side enables G_LB (phase 1), G_LA (phase 2): order, 50 us lead, 150 us lockout (§B13.3 rules 1-3)"
		(exclude_from_sim no)
		(at 315.48 330.766 0)
		(size 254.375 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
