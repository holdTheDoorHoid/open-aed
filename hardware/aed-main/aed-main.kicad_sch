				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "35c775d6-00c8-53ab-b4f6-70f10148d04b")
	)
	(text_box "How this project is organised"
		(exclude_from_sim no)
		(at 25.4 67.024 0)
		(size 140 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "abc3334f-af50-50b6-b425-191076f3fc6b")
	)
	(text_box "One KiCad project. Pages 2-10 (sheets 01-09) are the low-voltage group: power, the two controllers, user interface, the two\ncapacitor-voltage chains and the hardware interlock. Pages 11-16 (sheets 10-15) are the high-voltage and patient group:\ncharger, storage and discharge, output bridge, patient relay and pad connector, and the two front ends. If the layout uses\ntwo boards, the split runs between the groups (contract.md section 6).\nDesign: docs/HARDWARE_DESIGN.md. Net names, reference blocks and who captures what: hardware/aed-main/contract.md.\nGenerated by tools/schgen from the pin tables in specs/; never edit a .kicad_sch by hand (docs/HARDWARE_WORKFLOW.md)."
		(exclude_from_sim no)
		(at 25.4 73.374 0)
		(size 140 14.954)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4dd2ae87-cbed-5982-bbc8-2f6eb57f1a16")
	)
	(text_box "The three independent checks before a shock (docs/ARCHITECTURE.md)"
		(exclude_from_sim no)
		(at 25.4 108.648 0)
		(size 140 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "428ce304-cfc7-55e1-9f12-20ce997c11b3")
	)
	(text_box "1. Main controller (04): requests the shock (SHOCK_REQ) and holds the discharge path (HOLD_M).\n2. Supervisor (05): gives a short dynamic permit (PERMIT_CLK) and holds the discharge path (HOLD_S).\n3. Hardware interlock (09, 11): the bridge drive rail BRIDGE_5V exists only with request AND permit AND the discharge path\nheld; the discharge stacks conduct unless BOTH holds are present; the charger runs only while both stacks are held off\n(D-25)."
		(exclude_from_sim no)
		(at 25.4 114.998 0)
