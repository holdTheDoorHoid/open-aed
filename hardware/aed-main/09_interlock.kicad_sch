		(uuid "09484f9f-5100-539e-b389-e48afd5ac2aa")
	)
	(text_box "Charger gates (D-25, R-5): VTRANS_EN = CHG_SESSION AND HOLD_OK AND NOT TEST_MODE; CHARGE_EN = CHG_RUN AND HOLD_OK AND NOT TEST_MODE"
		(exclude_from_sim no)
		(at 25.4 261.872 0)
