* ==== C: Monte Carlo without and with one shorted device; then every single part fault
alterparam tf = 0.89
alterparam leakt = 262meg
alterparam ilk = 0.5u
set tn = cold
set rat = 1666
* ---- no_fault, 100 runs at 1950 V
set worst = 0
set wdet = none
set run = 0
while $run < 100
  let u = sunif(vector(36))
  let a0 = 1 + 0.02*u[0]
  alterparam ts1 = $&a0
  let a1 = 1 + 0.02*u[1]
  alterparam ts2 = $&a1
  let a2 = 1 + 0.02*u[2]
  alterparam ts3 = $&a2
  let a3 = 1 + 0.02*u[3]
  alterparam ts4 = $&a3
  let a4 = 1 + 0.02*u[4]
  alterparam tr1 = $&a4
  let a5 = 1 + 0.02*u[5]
  alterparam tr2 = $&a5
  let a6 = 1 + 0.02*u[6]
  alterparam tr3 = $&a6
  let a7 = 1 + 0.02*u[7]
  alterparam tr4 = $&a7
  let a8 = 1 + 0.02*u[8]
  alterparam tg2 = $&a8
  let a9 = 1 + 0.02*u[9]
  alterparam tg3 = $&a9
  let a10 = 1 + 0.02*u[10]
  alterparam tg4 = $&a10
  let a11 = 1 + 0.02*u[11]
  alterparam tb2 = $&a11
  let a12 = 1 + 0.02*u[12]
  alterparam tb3 = $&a12
  let a13 = 1 + 0.02*u[13]
  alterparam tb4 = $&a13
  let a14 = 1 + 0.02*u[14]
  alterparam tp1 = $&a14
  let a15 = 1 + 0.02*u[15]
  alterparam tp2 = $&a15
  let a16 = 1 + 0.02*u[16]
  alterparam tp3 = $&a16
  let a17 = 1 + 0.02*u[17]
  alterparam tp4 = $&a17
  let a18 = -3 + u[18]
  alterparam vo1 = $&a18
  let a19 = -3 + u[19]
  alterparam vo2 = $&a19
  let a20 = -3 + u[20]
  alterparam vo3 = $&a20
  let a21 = -3 + u[21]
  alterparam vo4 = $&a21
  let a22 = 0.51 + 0.49*u[22]
  alterparam lk1 = $&a22
  let a23 = 0.51 + 0.49*u[23]
  alterparam lk2 = $&a23
  let a24 = 0.51 + 0.49*u[24]
  alterparam lk3 = $&a24
  let a25 = 0.51 + 0.49*u[25]
  alterparam lk4 = $&a25
  let a26 = 0.5 + 0.5*u[26]
  alterparam dl2 = $&a26
  let a27 = 0.5 + 0.5*u[27]
  alterparam dl3 = $&a27
  let a28 = 0.5 + 0.5*u[28]
  alterparam dl4 = $&a28
  reset
  dc VCAP 0 1950 17.727272727272727
  let nl = length(v(vdsmax)) - 1
  let cur = v(vdsmax)[nl]
  let x1 = v(vds1)[nl]
  let x2 = v(vds2)[nl]
  let x3 = v(vds3)[nl]
  let x4 = v(vds4)[nl]
  let x5 = v(vdrmax)[nl]
  let x6 = v(vdfmax)[nl]
  let x7 = v(vsmax)[nl]
  let x8 = v(vgsmax)[nl]
  let x9 = -i(vcap)[nl]
  if cur > $worst
    set worst = $&cur
    set wdet = "v1=$&x1 v2=$&x2 v3=$&x3 v4=$&x4 diode_rev=$&x5 feed_100k=$&x6 string_elem=$&x7 vgs_upper=$&x8 I_path_A=$&x9"
  end
  let tmp = $run + 1
  set run = $&tmp
end
let mg = 1 - $worst/$rat
echo "STATIC no_fault T=$tn V=1950 runs=100 worst_vds=$worst rating=$rat margin=$&mg | $wdet"
