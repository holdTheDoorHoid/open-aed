* NOT FOR CONSTRUCTION — unreviewed design. Simulated results; models as stated; nothing has been built or measured.
* SPDX-License-Identifier: CERN-OHL-S-2.0
* GENERATED by gen_ctl.py - edit that file, not this one.
* Control script for stack_static_wpf.cir. Each solution is a DC sweep of the capacitor voltage from 0 V
* (continuation): a plain operating-point solve fails to converge for several fault cases and ngspice's fallback then
* returns an unsettled pseudo-transient state without saying so (found while writing these runs).
* Corners (IXYS DS100418B Fig. 12 read 2026-11-27; leakage log-interpolated [EST]): cold -20 C |VGS(off)| x0.89,
* rating 1,666 V; nom 25 C; hot 70 C x1.11, rating 1,700 V, GP02 leakage 50 uA (its 100 C maximum: bounding).
* Monte Carlo (uniform): 4.7 M, 10 M, 22 M, 100 M resistors +-2 %; VGS(off) -2..-4 V x corner factor; device leakage
* 2-100 % of the corner maximum; GP02 leakage 0-100 % of the corner value (dl 0.5..1 x2 range, see netlist).
.control
set noaskquit
set rndseed = 20261128
option reltol=1e-4
* ==== A: nominal parts
alterparam tf = 0.89
alterparam leakt = 262meg
alterparam ilk = 0.5u
set tn = cold
set rat = 1666
reset
dc VCAP 0 1950 17.727272727272727
let nl = length(v(vdsmax)) - 1
let cur = v(vdsmax)[nl]
let x1 = v(vds1)[nl]
let x2 = v(vds2)[nl]
let x3 = v(vds3)[nl]
let x4 = v(vds4)[nl]
let x5 = v(vdrmax)[nl]
let x6 = v(vdfmax)[nl]
let x7 = v(vsmax)[nl]
let x8 = v(vgsmax)[nl]
let x9 = -i(vcap)[nl]
