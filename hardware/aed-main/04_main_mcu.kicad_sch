	)
	(text_box "NRST: internal 30-50 kOhm pull-up (Table 102) + 100 nF to GND. PH3-BOOT0: 10 kOhm to GND = boot from user flash (Table 6).\nFirmware should also program nSWBOOT0 = 0, nBOOT0 = 1 so a lifted BOOT0 resistor cannot start the bootloader\n(capture-notes, firmware requirement).\nJ401: Tag-Connect TC2030-NL pads (no fitted connector), reachable only with the enclosure open (§B2.5). Separate from the\nsupervisor's pads J501: no debug path joins the controllers."
		(exclude_from_sim no)
		(at 669.055 31.75 0)
		(size 140 12.795)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "18b89a34-70a5-5de4-add6-70fe9498799a")
	)
	(text_box "Event record W25Q128JV (16 MB NOR) and durable store CY15B104QN (4 Mbit F-RAM) on SPI3"
		(exclude_from_sim no)
		(at 185.72 115.247 0)
		(size 261.725 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
