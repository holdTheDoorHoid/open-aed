	(text_box "Open-drain readbacks and status lines (issue 3: four hold-sensor readbacks HOLD_RB_A_N, HOLD_RB_B_N, HOLD_RB_A2_N, HOLD_RB_B2_N, R408/R409/R431/R432): 100 kOhm up, so open, unpowered or unsoldered reads \"not held /\nnot armed / not active / not done / no fault / not at rest / not fitted\" (R11). Contacts read by the main: 10 kOhm up (CANCEL_M_N, MODE_ADULT_N, MODE_CHILD_N). I2C_M bus 4.7 kOhm. PAD_ID_1W 2.2 kOhm. DOCK_TX 100\nkOhm up (UART idle)."
		(exclude_from_sim no)
		(at 185.72 234.625 0)
		(size 242.54 8.477)
		(margins 0.9525 0.9525 0.9525 0.9525)
