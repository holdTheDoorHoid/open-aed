			)
			(justify left top)
		)
		(uuid "f71200b6-3e6d-5ac1-bbfe-5ba85f102771")
	)
	(text_box "Capacitor-case NTC NTC_CAP_M (D-56), ratiometric to VREF_M"
		(exclude_from_sim no)
		(at 185.72 148.461 0)
		(size 140 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
