		)
		(uuid "de776f3a-4592-5e82-ba42-2ee9eed081dd")
	)
	(text_box "1:1,000 dividers and clamps to GND are on 13. Here: 100 kOhm (R7) + 10 nF C0G each (1 ms) into AIN1/AIN2. Error from the\nADC's typical 20 nA input current x 100 k = 2 mV = 2 V of output voltage: irrelevant for 'near 0' versus 'capacitor\nvoltage' decisions (§B14.3, F-8)."
		(exclude_from_sim no)
		(at 25.4 127.73 0)
		(size 140 8.477)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
