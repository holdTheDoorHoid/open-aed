				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "393df9e7-f067-5c93-b881-bf092ce06b43")
	)
	(text_box "Wake timer U305 RV-3028-C7 on 3V3_AON (I2C on the main bus, INT open drain, CLKOUT 1 Hz to the display and LED)"
		(exclude_from_sim no)
		(at 270.71 162.558 0)
		(size 191.48 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "97c24eac-0c83-5e7e-b59e-340ed5e577ea")
	)
	(text_box "App Manual rev 1.4 §7.1 'no backup source / event input not used': VBACKUP to VSS through 10 k (do not float; switchover disabled, BSM = 00 default), EVI to VSS through\na resistor (10 k), 100 nF at VDD.\nCLKOUT is push-pull and runs at 32.768 kHz from delivery until the firmware writes FD = 1 Hz and stores it in EEPROM (App Manual §4.6.3): a firmware requirement (capture\nnotes).\nI2C pull-ups are on 04 to 3V3_MAIN (contract §5.1); with the main off the bus sits low, which the RV-3028 tolerates (it is the VDD-powered side)."
		(exclude_from_sim no)
		(at 270.71 168.908 0)
		(size 191.48 12.795)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "85492dd2-c578-51f0-841a-b011d2d9e034")
	)
	(text_box "Ready latch U306 SN74AUP1G74 on 3V3_AON (cleared at power-up) + LED flash ~3 ms per second from RTC_CLKOUT"
		(exclude_from_sim no)
		(at 25.4 173.353 0)
		(size 183.08 5.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -1)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
