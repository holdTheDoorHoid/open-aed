	(paper "A3")
	(title_block
		(title "Supervisor capacitor-voltage chain: AD7171 + ADR3425, hardware over-voltage comparator")
		(date "2026-11-27")
		(rev "A-draft")
		(company "Open AED project — CERN-OHL-S-2.0 — NOT FOR CONSTRUCTION")
		(comment 1 "NOT FOR CONSTRUCTION — unreviewed design")
		(comment 2 "Source: docs/HARDWARE_DESIGN.md §B9.1, §B4.4, §B4.6; contract.md §5.4, §5.6")
		(comment 3 "Shares nothing with 07_sense_main: own rail 3V3_SUP, ADI ADC and reference, a different op-amp and comparator family, internal ADC clock (D-28).")
		(comment 4 "OVP_TRIP trips at 2,160 V nominal (band 2,132-2,189 V worst case) and releases near 1,000 V: the forced dump continues well below the operating range.")
		(comment 5 "Generated by tools/schgen from the sheet spec — edit the spec, not this file (until schematic freeze)")
	)
