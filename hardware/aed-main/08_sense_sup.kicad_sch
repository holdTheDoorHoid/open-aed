	(uuid "df9cd434-aea3-51a3-b904-de62a694c037")
	(paper "A2")
	(title_block
		(title "Supervisor capacitor-voltage chain: AD7171 + ADR3425, latching hardware over-voltage comparator")
		(date "2026-11-27")
		(rev "A-draft")
		(company "Open AED project — CERN-OHL-S-2.0 — NOT FOR CONSTRUCTION")
		(comment 1 "NOT FOR CONSTRUCTION — unreviewed design")
		(comment 2 "Source: docs/HARDWARE_DESIGN.md v0.3 §B9.1, §B4.4, §B4.6, §B14.5 (T-6); contract.md issue 3 §5.4, §5.6")
		(comment 3 "Shares nothing with 07_sense_main: own rail 3V3_SUP, ADI ADC and reference, a different op-amp and comparator family, internal ADC clock (D-28).")
		(comment 4 "OVP_TRIP trips at 2,107 V nominal (2,071-2,141 V worst case, -20..+70 C) and LATCHES: it stays high for any capacitor voltage until an OVP_RST rising edge or loss of 3V3_SUP (revision 0.3). OVP_TEST injects a trip at 0 V for the self-test T-6.")
		(comment 5 "Generated by tools/schgen from the sheet spec — edit the spec, not this file (until schematic freeze)")
	)
